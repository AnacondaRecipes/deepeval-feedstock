From 59033ea29b4fe6841cc0f5d607bb28c6d7dd1bce Mon Sep 17 00:00:00 2001
From: Andrii Osipov <aosipov@anaconda.com>
Date: Wed, 6 May 2026 05:55:00 -0700
Subject: [PATCH] Remove pytest-repeat from the deps to aboid pip check error

---
 PKG-INFO       | 1 -
 pyproject.toml | 1 -
 2 files changed, 2 deletions(-)

diff --git a/PKG-INFO b/PKG-INFO
index f19fd9c..f285e9a 100644
--- a/PKG-INFO
+++ b/PKG-INFO
@@ -28,7 +28,6 @@ Requires-Dist: pydantic-settings (>=2.10.1,<3.0.0)
 Requires-Dist: pyfiglet
 Requires-Dist: pytest
 Requires-Dist: pytest-asyncio
-Requires-Dist: pytest-repeat
 Requires-Dist: pytest-rerunfailures
 Requires-Dist: pytest-xdist
 Requires-Dist: python-dotenv (>=1.1.1,<2.0.0)
diff --git a/pyproject.toml b/pyproject.toml
index f8ba4ca..f087cbe 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -21,7 +21,6 @@ requests = "^2.31.0"
 tqdm = "^4.66.1"
 pytest = "*"
 pytest-xdist = "*"
-pytest-repeat = "*"
 pytest-rerunfailures = "*"
 pytest-asyncio = "*"
 tabulate = "^0.9.0"
